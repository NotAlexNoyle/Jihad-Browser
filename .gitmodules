[submodule "third_party/uxp"]
	path = third_party/uxp
	url = https://github.com/NotAlexNoyle/UXP.git
	branch = jihad-engine-mods
	# The engine delta now lives as a DURABLE COMMIT on this fork's `jihad-engine-mods` branch
	# (pristine Pale Moon UXP b2594a4 + the full jihad delta), and the parent gitlink pins it, so a
	# fresh clone + `git submodule update --init` gets the exact source the builds compile. This is
	# the change from the old model (url was upstream palemoon.org, delta was uncommitted working-
	# tree dirt reproduced by re-applying build/desktop/patches/*.patch): committing to an upstream
	# url would have been unclonable, so the fork exists precisely to make it clonable.
	# The desktop/host build still applies build/desktop/patches/*.patch idempotently, but they are
	# already baked into this commit, so `patch --forward` skips them and the tree stays clean.
	# `ignore = dirty` remains, harmless: only the recorded COMMIT matters, and it is what the OE
	# SRCREV (build/webos-oe/recipes-jihad/goanna/goanna_1.0.bb) and this gitlink both pin.
	ignore = dirty
[submodule "third_party/mochi"]
	path = third_party/mochi
	url = https://github.com/webOSArchive/mochi
[submodule "third_party/mochi-sampler"]
	path = third_party/mochi-sampler
	url = https://github.com/webOSArchive/mochi-sampler
[submodule "third_party/enyo-layout"]
	path = third_party/enyo-layout
	url = https://github.com/enyojs/layout
