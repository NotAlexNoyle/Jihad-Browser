[submodule "third_party/uxp"]
	path = third_party/uxp
	url = https://github.com/NotAlexNoyle/UXP-Jihad.git
	branch = jihad/uxp-RB_20261006
	# The engine: upstream UXP at a release tag (build/engine/engine-version.env, UXP_TAG) plus Jihad's
	# commits on this fork's branch jihad/uxp-<tag>; the parent gitlink pins the exact commit, so a fresh
	# clone + `git submodule update --init` gets the source the builds compile once that branch is pushed
	# to the fork. build/engine/update-engine.sh --finish rewrites `branch` with the other pins, and
	# check-engine-pins.sh checks it. build/desktop/patches/ is the same commits as git mails
	# (docs/ENGINE.md §1–2). `ignore = dirty`: only the recorded COMMIT matters, and it is what the OE
	# SRCREV (build/webos-oe/recipes-jihad/goanna/goanna_1.0.bb) and this gitlink both pin.
	ignore = dirty
[submodule "third_party/mochi"]
	path = third_party/mochi
	url = https://github.com/webOSArchive/mochi
[submodule "third_party/mochi-sampler"]
	path = third_party/mochi-sampler
	url = https://github.com/webOSArchive/mochi-sampler
[submodule "third_party/enyo-layout"]
	path = third_party/enyo-layout
	url = https://github.com/enyojs/layout
[submodule "third_party/libpbnjson"]
	# The adapter's pbnjson headers, at submissions/10 (the device era: build-adapter-pdk.sh).
	path = third_party/libpbnjson
	url = https://github.com/openwebos/libpbnjson
[submodule "third_party/yajl"]
	# yajl 1.0.12's API headers for the alternate gcc-9 adapter (build-adapter-arm.sh).
	path = third_party/yajl
	url = https://github.com/lloyd/yajl
[submodule "third_party/npapi-headers"]
	# isis NPAPI headers 0.4; build/webos-oe/adapter-include/npapi/ links three of them and
	# carries Jihad's own npapi.h (the device's touch event) and the nppalmdefs.h shim.
	path = third_party/npapi-headers
	url = https://github.com/isis-project/npapi-headers
[submodule "third_party/crosstool-ng"]
	# crosstool-NG 1.25.0, built inside the toolchain container (build/webos-oe/toolchain/build.sh).
	path = third_party/crosstool-ng
	url = https://github.com/crosstool-ng/crosstool-ng
[submodule "third_party/webos-sdk-redux"]
	# webOS Archive's modern webOS SDK: palm-package & co (Java) and the novacom/novacomd
	# sources (tools/host/build-novacom.sh). build/webos-oe/host-path.sh puts its bin/ on PATH.
	path = third_party/webos-sdk-redux
	url = https://github.com/webOSArchive/webos-sdk-redux
	shallow = true
[submodule "build/webos-oe/build-webos"]
	# openwebos build-webos for the optional OpenEmbedded route (oe-env.sh checks it out on
	# first use). Not checked out by a plain `git submodule update --init`; its build output
	# stays inside it, so git does not look at its state.
	path = build/webos-oe/build-webos
	url = https://github.com/openwebos/build-webos
	update = none
	ignore = all
[submodule "third_party/pulseaudio"]
	# PulseAudio 0.9.22 (the TouchPad's): its src/pulse/*.h go into the ARM sysroot
	# (build/webos-oe/arm-sysroot.recipe) for cubeb_pulse.
	path = third_party/pulseaudio
	url = https://gitlab.freedesktop.org/pulseaudio/pulseaudio.git
	shallow = true
