[submodule "third_party/uxp"]
	path = third_party/uxp
	url = https://github.com/NotAlexNoyle/UXP-Jihad.git
	branch = jihad/uxp-RB_20261006
	# The engine: upstream UXP at a release tag (build/engine/engine-version.env, UXP_TAG) plus Jihad's
	# commits on this fork's branch jihad/uxp-<tag>; the parent gitlink pins the exact commit, so a fresh
	# clone + `git submodule update --init` gets the source the builds compile once that branch is pushed
	# to the fork. build/engine/update-engine.sh --finish rewrites `branch` with the other pins, and
	# check-engine-pins.sh checks it. build/desktop/patches/ is the same commits as git mails
	# (docs/ENGINE.md §1–2). `ignore = dirty`: only the recorded COMMIT matters, and it is what the OE
	# SRCREV (build/webos-oe/recipes-jihad/goanna/goanna_1.0.bb) and this gitlink both pin.
	ignore = dirty
[submodule "third_party/mochi"]
	path = third_party/mochi
	url = https://github.com/webOSArchive/mochi
[submodule "third_party/mochi-sampler"]
	path = third_party/mochi-sampler
	url = https://github.com/webOSArchive/mochi-sampler
[submodule "third_party/enyo-layout"]
	path = third_party/enyo-layout
	url = https://github.com/enyojs/layout
