# Jihad SPIKE: X/GTK-free headless toolkit (desktop x86_64, maps the cascade).
mk_add_options MOZ_OBJDIR=/out/obj-jihad-headless
mk_add_options MOZ_MAKE_FLAGS="-j8"
ac_add_options --enable-application=xulrunner
ac_add_options --enable-default-toolkit=cairo-headless
ac_add_options --enable-optimize
ac_add_options --disable-debug
ac_add_options --disable-warnings-as-errors
ac_add_options --disable-tests --disable-updater --disable-crashreporter
ac_add_options --disable-maintenance-service --disable-webrtc --disable-gamepad
ac_add_options --disable-jemalloc --disable-alsa --disable-pulseaudio --disable-necko-wifi --disable-dbus --disable-npapi-gtk2 --disable-printing
export CFLAGS="$CFLAGS -Wno-error=format-overflow -Wno-error=format"
export CXXFLAGS="$CXXFLAGS -Wno-error=format-overflow -Wno-error=format"
