+    // reads stay valid, and skip all widget realization. System colours fall back
+    // to GTK defaults; CSS-styled web content does not depend on them.
+    if (!gdk_display_get_default()) {
+#if (MOZ_WIDGET_GTK == 2)
+        if (!mStyle) {
+            mStyle = gtk_style_new();
+        }
+#endif
+        return;
+    }
