+    gl->fEnableVertexAttribArray(mJihadSwizzlePos);
+    gl->fVertexAttribPointer(mJihadSwizzlePos, 2, LOCAL_GL_FLOAT, LOCAL_GL_FALSE, 0, kQuad);
