+        GetCurrentWidgetListener()->PaintWindow(this, region);
+      } else if (mTabChild) {
+        // Do nothing, the compositor will handle drawing
         mTabChild->NotifyPainted();
       }
     } else if (mozilla::layers::LayersBackend::LAYERS_BASIC == mLayerManager->GetBackendType()) {
