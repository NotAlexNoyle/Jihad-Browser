+}
+
+bool
+PuppetWidget::JihadComposeTo(nsIDocShell* aDocShell, void* aDest, int aStride,
+                             int aWidth, int aHeight)
+{
+  if (!aDocShell || !aDest || aWidth <= 0 || aHeight <= 0 || aStride < aWidth * 4) {
+    return false;
+  }
+  nsCOMPtr<nsIPresShell> presShell = aDocShell->GetPresShell();
+  if (!presShell) {
+    return false;
+  }
+  presShell->FlushPendingNotifications(Flush_Layout);
+  nsViewManager* vm = presShell->GetViewManager();
+  nsView* root = vm ? vm->GetRootView() : nullptr;
+  nsIWidget* viewWidget = root ? root->GetWidget() : nullptr;
+  if (!viewWidget) {
+    return false;
+  }
+  // The view's widget is the CHILD PuppetWidget nsView::CreateWidgetForParent made; it shares
+  // this widget's layer manager (PuppetWidget::Create). A BasicLayerManager here means the
+  // compositor was never created: not this path.
+  LayerManager* lm = viewWidget->GetLayerManager();
+  ClientLayerManager* clm = lm ? lm->AsClientLayerManager() : nullptr;
+  if (!clm) {
+    return false;
+  }
+  mozilla::TimeStamp t0 = mozilla::TimeStamp::Now();
+  // 1. The layer tree: the root view's frames painted into layers and forwarded to the
+  //    compositor (which also composites on its own vsync; the snapshot below is the frame
+  //    the daemon keeps, so that one is wasted work to remove once the spike has its number).
+  nsRegion dirty(root->GetDimensions());
+  presShell->Paint(root, dirty, nsIPresShell::PAINT_LAYERS);
+  mozilla::TimeStamp t1 = mozilla::TimeStamp::Now();
+  // 2. The snapshot: an empty transaction with a target makes the client ask the compositor
+  //    (sync IPC on the compositor thread) to compose into a shared surface, then draw that
+  //    surface into our target: CompositorOGL::EndFrame -> CopyToTarget -> glReadPixels.
+  RefPtr<DrawTarget> dt = Factory::CreateDrawTargetForData(
+      BackendType::CAIRO, static_cast<unsigned char*>(aDest),
+      IntSize(aWidth, aHeight), aStride, SurfaceFormat::B8G8R8A8);
+  if (!dt || !dt->IsValid()) {
+    return false;
+  }
+  dt->FillRect(mozilla::gfx::Rect(0, 0, aWidth, aHeight),
+               mozilla::gfx::ColorPattern(mozilla::gfx::Color(1.f, 1.f, 1.f, 1.f)));
+  RefPtr<gfxContext> ctx = gfxContext::CreateOrNull(dt);
+  if (!ctx) {
+    return false;
+  }
+  bool ok = false;
+  if (clm->BeginTransactionWithTarget(ctx)) {
+    ok = clm->EndEmptyTransaction();
+  }
+  mozilla::TimeStamp t2 = mozilla::TimeStamp::Now();
+  static uint32_t sFrames = 0;
+  if (sFrames < 100 || (sFrames % 50) == 0) {
+    fprintf(stderr, "[jihad-gpu] frame %u: layers %.1f ms, compose+readback %.1f ms, ok=%d, compositor backend %d\n",
+            sFrames, (t1 - t0).ToMilliseconds(), (t2 - t1).ToMilliseconds(), (int)ok,
+            (int)clm->GetCompositorBackendType());
+  }
+  ++sFrames;
+  return ok;
+}
