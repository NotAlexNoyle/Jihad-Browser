+bool
+CompositorOGL::JihadReadFrame(uint8_t* aDest, int aStride, int aWidth, int aHeight)
+{
+  if (!mGLContext || !aDest || aWidth <= 0 || aHeight <= 0 || aStride != aWidth * 4) {
+    return false;
+  }
+  const int w = std::min<int>(aWidth, mWidgetSize.width), h = std::min<int>(aHeight, mWidgetSize.height);
+  if (w <= 0 || h <= 0) {
+    return false;
+  }
+  mGLContext->MakeCurrent();
+  mGLContext->fBindFramebuffer(LOCAL_GL_FRAMEBUFFER, mJihadWindowFBO);
+  {
+    // Row 0 of the read is the top of the image: an offscreen context draws with no view flip.
+    ScopedPackState safePackState(mGLContext);
+    mGLContext->fPixelStorei(LOCAL_GL_PACK_ALIGNMENT, 4);
+    mGLContext->fReadPixels(0, 0, w, h, LOCAL_GL_RGBA, LOCAL_GL_UNSIGNED_BYTE, aDest);
+  }
+  for (int y = 0; y < h; y++) {
+    uint8_t* p = aDest + (size_t)y * aStride;
+    int x = 0;
+#if defined(__ARM_NEON__) || defined(__ARM_NEON)
+    for (; x + 16 <= w; x += 16, p += 64) {
+      uint8x16x4_t v = vld4q_u8(p);
+      uint8x16_t r = v.val[0]; v.val[0] = v.val[2]; v.val[2] = r;
+      vst4q_u8(p, v);
+    }
+#endif
+    for (; x < w; x++, p += 4) {
+      const uint8_t r = p[0]; p[0] = p[2]; p[2] = r;
+    }
+  }
+  return true;
+}
