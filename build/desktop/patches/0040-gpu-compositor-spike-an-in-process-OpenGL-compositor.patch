+      if (JihadGpuCompositor() && !mJihadCompositorTried && !mTabChild &&
+          gfxPlatform::UsesOffMainThreadCompositing()) {
+        // Jihad T-502: an in-process compositor behind a ClientLayerManager. Tried once: on
