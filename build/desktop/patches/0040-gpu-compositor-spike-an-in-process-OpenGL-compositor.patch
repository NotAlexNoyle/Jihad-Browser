+}
+
+bool
+CompositorBridgeParent::JihadComposeAndRead(uint8_t* aDest, int aStride, int aWidth, int aHeight)
+{
+  MOZ_ASSERT(CompositorThreadHolder::IsInCompositorThread());
+  if (!mCompositor) {
+    return false;
+  }
+  TimeStamp t0 = TimeStamp::Now();
+  ForceComposeToTarget(nullptr, nullptr);
+  TimeStamp t1 = TimeStamp::Now();
+  CompositorOGL* ogl = mCompositor->AsCompositorOGL();
+  if (!ogl) {
+    return false;
+  }
+  bool ok = ogl->JihadReadFrame(aDest, aStride, aWidth, aHeight);
+  static uint32_t sFrames = 0;
+  if (sFrames < 20 || (sFrames % 50) == 0) {
+    fprintf(stderr, "[jihad-gpu] compositor thread: compose %.1f ms, read %.1f ms (frame %u, ok=%d)\n",
+            (t1 - t0).ToMilliseconds(), (TimeStamp::Now() - t1).ToMilliseconds(), sFrames, (int)ok);
+  }
+  ++sFrames;
+  return ok;
+}
