+namespace {
+// T-502: one frame pulled from the compositor thread. Heap-allocated and owned by whichever side
+// finishes last, so a waiter that gives up (abandoned) leaves nothing dangling for the task.
+struct JihadReadJob {
+  mozilla::layers::CompositorBridgeParent* bridge;
+  uint8_t* dest; int stride, w, h;
+  mozilla::Monitor mon;
+  bool done, ok, abandoned;
+  JihadReadJob(mozilla::layers::CompositorBridgeParent* b, uint8_t* d, int st, int wi, int he)
+    : bridge(b), dest(d), stride(st), w(wi), h(he), mon("jihad-compose"), done(false), ok(false), abandoned(false) {}
+};
+void JihadReadOnCompositorThread(JihadReadJob* job)
+{
+  bool ok = job->bridge->JihadComposeAndRead(job->dest, job->stride, job->w, job->h);
+  bool abandoned;
+  {
+    mozilla::MonitorAutoLock lock(job->mon);
+    job->ok = ok; job->done = true; abandoned = job->abandoned;
+    job->mon.Notify();
+  }
+  if (abandoned) {
+    delete job;
+  }
+}
