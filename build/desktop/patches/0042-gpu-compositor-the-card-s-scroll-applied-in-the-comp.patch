diff --git a/gfx/layers/ipc/CompositorBridgeParent.cpp b/gfx/layers/ipc/CompositorBridgeParent.cpp
index 06d50599f3..319b883838 100644
--- a/gfx/layers/ipc/CompositorBridgeParent.cpp
