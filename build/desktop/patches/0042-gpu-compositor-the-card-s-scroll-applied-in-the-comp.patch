+    pbOk = static_cast<GLContextEGL*>(mGLContext.get())->JihadUsePBufferOfSize(aWidth, aHeight);
+    if (pbOk) mJihadPbSize = gfx::IntSize(aWidth, aHeight);
+  }
+  mGLContext->MakeCurrent();
