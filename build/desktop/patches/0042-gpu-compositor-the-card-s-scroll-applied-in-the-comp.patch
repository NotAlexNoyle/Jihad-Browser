 struct JihadFrameRequest {
   uint8_t* dest = nullptr;
   int stride = 0, w = 0, h = 0;
-  int lo = 0, hi = 0;                  // the rows to read, top-down ((0,0) = every row)
+  int lo = 0, hi = 0;                  // the rows to read, top-down ((0,0) = none asked for)
