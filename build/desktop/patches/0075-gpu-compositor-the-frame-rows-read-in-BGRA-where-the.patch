-      mGLContext->fReadPixels(0, h - hi, w, rows, LOCAL_GL_RGBA, LOCAL_GL_UNSIGNED_BYTE, tmp);
+      mGLContext->fReadPixels(0, h - hi, w, rows, JihadReadFormat(mGLContext), LOCAL_GL_UNSIGNED_BYTE, tmp);
       if (mJihadCancel && *mJihadCancel) {
