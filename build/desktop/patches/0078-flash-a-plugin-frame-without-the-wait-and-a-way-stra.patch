+extern "C" MOZ_EXPORT void
+jihad_plugin_lane_set(int aOpen)
+{
+    gJihadLaneOpen = aOpen != 0;
+    if (!aOpen) {
+        PluginInstanceParent::JihadLaneClosed();
+    }
