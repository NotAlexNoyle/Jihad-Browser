@@ -1261,13 +1265,17 @@ PluginInstanceParent::RecvShow(const NPRect& updatedRect,
             image = new SourceSurfaceImage(ssize, sourceSurface);
         }
 
-        ImageContainer::NonOwningImage holder(image);
-        holder.mFrameID = ++mFrameID;
