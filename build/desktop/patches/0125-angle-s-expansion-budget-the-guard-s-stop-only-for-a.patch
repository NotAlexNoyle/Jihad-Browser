From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: NotAlexNoyle <alexnoyle@icloud.com>
Date: Thu, 19 Nov 2026 12:01:15 -0500
Subject: [PATCH] angle's expansion budget; the guard's stop only for a long
 script, its window told

From the adversarial review of 0122/0124 (Codex, 2026-11-19):

- ANGLE: argument nesting was bounded but the tokens expansion produces were
  not: #define D(x) x x nested 26 deep made 2^26 tokens inside a synchronous
  shader compile, where no script interrupt can help. All expansions of one
  shader (the expanders nested in argument pre-expansion included) now share
  a budget of 100 000 tokens, counted before any vector grows; past it the
  macro is refused with PP_OUT_OF_MEMORY.
- jihad_js_stop_scripts: a window opened while no script ran could stop an
  unrelated script that began inside it; only a content script that has run
  2 s or more in this task is stopped. The outer window it ran in is told to
  the embedder ("jihad-memory-script-stopped", on the next turn of the event
  loop) so the page shed is that one, not merely the newest. The context
  leaves the stop's reach in ~XPCJSContext.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01MpagfKTnbF5UuSGLUYcN1P
---
 .../compiler/preprocessor/MacroExpander.cpp   | 41 ++++++++++++++++---
 .../src/compiler/preprocessor/MacroExpander.h | 10 ++++-
 js/xpconnect/src/XPCJSContext.cpp             | 22 +++++++++-
 3 files changed, 65 insertions(+), 8 deletions(-)

diff --git a/gfx/angle/src/compiler/preprocessor/MacroExpander.cpp b/gfx/angle/src/compiler/preprocessor/MacroExpander.cpp
index 2089adbabe..59a1f23829 100755
--- a/gfx/angle/src/compiler/preprocessor/MacroExpander.cpp
+++ b/gfx/angle/src/compiler/preprocessor/MacroExpander.cpp
@@ -47,11 +47,21 @@ class TokenLexer : public Lexer
 };
 
 MacroExpander::MacroExpander(Lexer *lexer, MacroSet *macroSet, Diagnostics *diagnostics,
-                             int allowedDepth)
-    : mLexer(lexer), mMacroSet(macroSet), mDiagnostics(diagnostics), mAllowedDepth(allowedDepth)
+                             int allowedDepth, size_t *sharedBudget)
+    : mLexer(lexer), mMacroSet(macroSet), mDiagnostics(diagnostics), mAllowedDepth(allowedDepth),
+      mOwnBudget(0), mBudget(sharedBudget ? sharedBudget : &mOwnBudget)
 {
 }
 
+// Jihad: n more tokens out of the shader's expansion budget, or false when it is spent
+bool MacroExpander::spend(size_t n)
+{
+    if (*mBudget + n > kMaxExpandedTokens)
+        return false;
+    *mBudget += n;
+    return true;
+}
+
 MacroExpander::~MacroExpander()
 {
     for (std::size_t i = 0; i < mContextStack.size(); ++i)
@@ -192,6 +202,11 @@ bool MacroExpander::expandMacro(const Macro &macro,
     SourceLocation replacementLocation = identifier.location;
     if (macro.type == Macro::kTypeObj)
     {
+        if (!spend(macro.replacements.size()))
+        {
+            mDiagnostics->report(Diagnostics::PP_OUT_OF_MEMORY, identifier.location, identifier.text);
+            return false;
+        }
         replacements->assign(macro.replacements.begin(),
                              macro.replacements.end());
 
@@ -232,7 +247,11 @@ bool MacroExpander::expandMacro(const Macro &macro,
         if (!collectMacroArgs(macro, identifier, &args, &replacementLocation))
             return false;
 
-        replaceMacroParams(macro, args, replacements);
+        if (!replaceMacroParams(macro, args, replacements))
+        {
+            mDiagnostics->report(Diagnostics::PP_OUT_OF_MEMORY, identifier.location, identifier.text);
+            return false;
+        }
     }
 
     for (std::size_t i = 0; i < replacements->size(); ++i)
@@ -338,12 +357,17 @@ bool MacroExpander::collectMacroArgs(const Macro &macro,
             return false;
         }
         TokenLexer lexer(&arg);
-        MacroExpander expander(&lexer, mMacroSet, mDiagnostics, mAllowedDepth - 1);
+        MacroExpander expander(&lexer, mMacroSet, mDiagnostics, mAllowedDepth - 1, mBudget);
 
         arg.clear();
         expander.lex(&token);
         while (token.type != Token::LAST)
         {
+            if (!spend(1))
+            {
+                mDiagnostics->report(Diagnostics::PP_OUT_OF_MEMORY, identifier.location, identifier.text);
+                return false;
+            }
             arg.push_back(token);
             expander.lex(&token);
         }
@@ -351,7 +375,7 @@ bool MacroExpander::collectMacroArgs(const Macro &macro,
     return true;
 }
 
-void MacroExpander::replaceMacroParams(const Macro &macro,
+bool MacroExpander::replaceMacroParams(const Macro &macro,
                                        const std::vector<MacroArg> &args,
                                        std::vector<Token> *replacements)
 {
@@ -360,6 +384,8 @@ void MacroExpander::replaceMacroParams(const Macro &macro,
         const Token &repl = macro.replacements[i];
         if (repl.type != Token::IDENTIFIER)
         {
+            if (!spend(1))
+                return false;
             replacements->push_back(repl);
             continue;
         }
@@ -371,6 +397,8 @@ void MacroExpander::replaceMacroParams(const Macro &macro,
             macro.parameters.begin(), macro.parameters.end(), repl.text);
         if (iter == macro.parameters.end())
         {
+            if (!spend(1))
+                return false;
             replacements->push_back(repl);
             continue;
         }
@@ -381,12 +409,15 @@ void MacroExpander::replaceMacroParams(const Macro &macro,
         {
             continue;
         }
+        if (!spend(arg.size()))
+            return false;
         std::size_t iRepl = replacements->size();
         replacements->insert(replacements->end(), arg.begin(), arg.end());
         // The replacement token inherits padding properties from
         // macro replacement token.
         replacements->at(iRepl).setHasLeadingSpace(repl.hasLeadingSpace());
     }
+    return true;
 }
 
 }  // namespace pp
