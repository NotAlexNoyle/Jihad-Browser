+bool
+PuppetWidget::JihadOffscreen()
+{
+  static int sMode = -1;
+  if (sMode < 0) {
+    const char* e = getenv("JIHAD_OFFSCREEN");
+    sMode = (e && *e) ? 1 : 0;
+  }
+  return sMode == 1;
