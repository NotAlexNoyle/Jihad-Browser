# The engine this build embeds — one place for every pin and version string an update changes.
# build/engine/check-engine-pins.sh fails when anything in the repo disagrees with this file;
# docs/ENGINE.md says how to update the engine and which of these to bump.

# The upstream UXP release our engine branch sits on, and its commit (pristine;
# repo.palemoon.org MoonchildProductions/UXP). build/engine/update-engine.sh moves these.
UXP_TAG=RB_20261006
UXP_BASE=5f290d1097a8350b56ce2092aa9d5fc9147c6661
# The tip of our engine branch (NotAlexNoyle/UXP-Jihad, jihad/uxp-<UXP_TAG>: one commit per patch
# in build/desktop/patches) the build uses. The third_party/uxp gitlink and the OE recipe's SRCREV
# must both be this commit.
UXP_PIN=dba5c890abba252cca31e2d1cc03b100b1886019
# What the user agent and the start pages say: Goanna version and the short UPSTREAM base.
GOANNA_VERSION=6.9
UXP_SHORT=5f290d1
# The ICU data file the engine ships (make-device-bundle.sh, gen-variant-scripts.sh).
ICU_DATA=icudt78l.dat
