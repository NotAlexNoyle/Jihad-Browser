# The engine this build embeds — one place for every pin and version string an update changes.
# build/engine/check-engine-pins.sh fails when anything in the repo disagrees with this file;
# docs/ENGINE.md says how to update the engine and which of these to bump.

# Upstream UXP commit our engine branch sits on (pristine; repo.palemoon.org MoonchildProductions/UXP).
UXP_BASE=b2594a4ace4556b0a953c079a8c1bc350fc095ec
# The tip of our engine branch (NotAlexNoyle/UXP-Jihad, jihad-engine-mods) the build uses. The
# third_party/uxp gitlink and the OE recipe's SRCREV must both be this commit.
UXP_PIN=db070f0003f22a50222f43b882499480d20c2ef7
# The engine branch's commit that holds the original squashed patch series (0001-0031).
UXP_SQUASH=07259a27f0
# What the user agent and the start pages say: Goanna version and the short UPSTREAM base.
GOANNA_VERSION=6.9
UXP_SHORT=b2594a4
# The ICU data file the engine ships (make-device-bundle.sh, gen-variant-scripts.sh).
ICU_DATA=icudt78l.dat
