libyajl.so	libyajl.so.1
#
# ============================================================================
# SECTION: NPAPI-HEADERS  (staging/include/webkit/npapi)
# origin=npapi-headers means byte-identical to the pinned npapi-headers checkout, so a
# clean clone regenerates it. origin=palm-only means it exists nowhere else in this repo
# and travels with the device drop.
# origin=npapi-headers+jihad means the pinned checkout's file with a recorded local fix; the
# recipe to reproduce it is in the entry's comment, and the build has a compile-time guard.
# TSV: path  sha256  size_bytes  origin
# ============================================================================
# npapi.h RE-STAGED 2026-08-15 (T-120). Was 462bcc89…1752b / 35552 bytes, the repo-root copy of
# the npapi-headers checkout, which declares a 12-byte NpPalmTouchEvent. The device pushes 28
# bytes. Reproduce: take the checkout's repo-root npapi.h and replace ONLY the NpPalmTouchEvent
# struct with the one from npapi-headers/debian/npapiheaders/usr/include/npapi.h (three
# NpPalmTouchList + int32_t modifiers). Not a whole-file swap — see the comment in the header.
# BrowserAdapter::doTouchEvent carries sizeof(NpPalmTouchEvent)==28 as a compile-time guard, so
# a re-stage that reverts this fails the adapter build rather than crashing LunaSysMgr.
webkit/npapi/npapi.h	36b58a83636bdc19de927772ee6a111db0b657b87595ae51d0766e20ff21c199	36646	npapi-headers+jihad
webkit/npapi/nppalmdefs.h	804fd4e8de6220ca9e2dbf634538a323df8d92ddbb3fc715d6332c4e1279b0f1	341	palm-only
webkit/npapi/npruntime.h	569e1e9b73ebee0698314817b847c56a7414af6ae6d431e6d47779216958668d	16392	npapi-headers
webkit/npapi/nptypes.h	5a95b0cfedef732596bf156e1fd3b755c31b8eb39cba772703270c07c7a37f3f	3846	npapi-headers
webkit/npapi/npupp.h	8a1d65c0dc634565b919131c553ca924cb78913b7493e5eed854fddb64228273	26046	npapi-headers
