staging/lib	0412309eb02933960fd2becc203e69d1a58adf220fa24fbddcc603f2fd61ff0a	7 files, 10 symlinks
staging/include	0b293a1946d806761d28596cf280c15c4b838672ffff1684b7cf2246812ca21a	5 files, 0 symlinks
