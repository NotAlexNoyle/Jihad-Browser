#
# TouchPad: light sensor off — the install half. A self-contained patch package in the shape of the community's AUSMT
# patches (backups as <file>.webosinternals.orig, a record under /var/usr/lib/.webosinternals.patches/<id>/) but with
# no dependence on the webOS Internals patch tools: webOS CE 3.1.0 ships busybox's patch (-p, -R, -N; no -d, hence
# the cd /; its help lists --dry-run but the binary refuses it) and nothing of the Internals feeds, so the check before
# and after is by md5: the stock files and the patched files are both known. Idempotent: a file already patched is
# left alone; a file that is neither the stock one nor the patched one stops the install with the reason.
ID=net.riverstonerelay.patches.touchpad-light-sensor-off
APP_DIR=/media/cryptofs/apps/usr/palm/applications/$ID
PATCH=$APP_DIR/touchpad-light-sensor-off.patch
CONTROL_DIR=/var/usr/lib/.webosinternals.patches/$ID
LOG=/media/internal/webos-patches.log
FILES="/etc/usd/usd_topaz-Wifi_default.xml /etc/usd/usd_topaz-3G_default.xml"
# the md5 of each file as shipped (webOS CE 3.1.0 = stock 3.0.5, dated 2011-12-21) and as this patch leaves it
STOCK="ed63161905770498a89bd26a0d94c26b 079b6de8d9a1f02817e1f1088646ff69"
PATCHED="6e9647dcffc281d7703e321e3dab0629 c48489efcbdf02ac7fd5f7e8d81e9e32"
say() { echo "$ID: $*"; echo "$(date '+%F %T') $ID: $*" >> $LOG 2>/dev/null; }
fail() { say "FAILED: $*"; exit 1; }
sum() { md5sum "$1" | cut -c1-32; }
[ -f "$PATCH" ] || fail "no patch file at $PATCH"
mount -o rw,remount / || fail "could not remount / read-write"
cd / || fail "no /"
for f in $FILES; do [ -f "$f" ] || fail "$f is not on this device (not a TouchPad?)"; done
state=""
for f in $FILES; do m=$(sum "$f"); case " $PATCHED " in *" $m "*) state="$state p";; *) case " $STOCK " in *" $m "*) state="$state s";; *) fail "$f is neither the stock file nor the patched one (md5 $m): nothing changed";; esac;; esac; done
if [ "$state" = " p p" ]; then
	say "already applied; nothing to do"
else
	[ "$state" = " s s" ] || fail "one file is patched and the other stock: put both back by hand first"
	for f in $FILES; do [ -f "$f.webosinternals.orig" ] || cp -p "$f" "$f.webosinternals.orig" || fail "could not back up $f"; done
	if ! patch -p1 -N < "$PATCH" >/dev/null 2>&1; then for f in $FILES; do cp -p "$f.webosinternals.orig" "$f"; done; fail "patch did not apply; the files are back as they were"; fi
	for f in $FILES; do m=$(sum "$f"); case " $PATCHED " in *" $m "*) ;; *) for g in $FILES; do cp -p "$g.webosinternals.orig" "$g"; done; fail "$f did not come out as expected (md5 $m); the files are back as they were";; esac; done
	mkdir -p "$CONTROL_DIR" 2>/dev/null
	{ for f in $FILES; do md5sum "$f"; done; } > "$CONTROL_DIR/file_list" 2>/dev/null
	cp "$PATCH" "$CONTROL_DIR/" 2>/dev/null
	say "applied to $FILES"
fi
# sensord reads its driver list at start: restart it (upstart keeps it respawning; rotation comes back within seconds)
stop sensord >/dev/null 2>&1; sleep 1; start sensord >/dev/null 2>&1
say "sensord restarted; the light sensor is no longer polled"
exit 0
