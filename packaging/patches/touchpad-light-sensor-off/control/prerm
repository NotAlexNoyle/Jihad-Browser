# TouchPad: light sensor off — the remove half: the backups go back (or the patch is reversed when a backup is
# missing), the record is removed, sensord restarted so it polls the sensor again as stock does.
ID=net.riverstonerelay.patches.touchpad-light-sensor-off
APP_DIR=/media/cryptofs/apps/usr/palm/applications/$ID
PATCH=$APP_DIR/touchpad-light-sensor-off.patch
CONTROL_DIR=/var/usr/lib/.webosinternals.patches/$ID
LOG=/media/internal/webos-patches.log
FILES="/etc/usd/usd_topaz-Wifi_default.xml /etc/usd/usd_topaz-3G_default.xml"
say() { echo "$ID: $*"; echo "$(date '+%F %T') $ID: $*" >> $LOG 2>/dev/null; }
mount -o rw,remount / || { say "could not remount / read-write"; exit 1; }
cd / || exit 1
PATCHED="6e9647dcffc281d7703e321e3dab0629 c48489efcbdf02ac7fd5f7e8d81e9e32"
reversed=0
for f in $FILES; do
	if [ -f "$f.webosinternals.orig" ]; then mv -f "$f.webosinternals.orig" "$f" && say "$f restored from its backup"
	elif [ $reversed = 0 ] && [ -f "$PATCH" ] && case " $PATCHED " in *" $(md5sum "$f" | cut -c1-32) "*) true;; *) false;; esac; then
		patch -p1 -R < "$PATCH" >/dev/null 2>&1 && { reversed=1; say "the files reversed by the patch (no backup was there)"; }
	elif [ $reversed = 0 ]; then say "$f: no backup and not the patched file; left as it is"; fi
done
rm -rf "$CONTROL_DIR" 2>/dev/null
stop sensord >/dev/null 2>&1; sleep 1; start sensord >/dev/null 2>&1
say "removed; sensord restarted"
exit 0
