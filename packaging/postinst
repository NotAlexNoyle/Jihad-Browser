#!/bin/sh
# Jihad Browser -- post-install. Runs as ROOT under Preware / WebOS Quick Install.
# Lays the bundled Goanna daemon + NPAPI adapter + upstart job into place so the app
# is a SELF-CONTAINED Goanna browser that COEXISTS with the stock system browser:
#   - our adapter:  /usr/lib/BrowserPlugins/BrowserAdapterJihad.so  (application/x-jihad-browser)
#   - our daemon:   /media/internal/jihad/hl/jihad-browserserver    (-> /tmp/yapserver.jihad-browser)
#   - our upstart:  /etc/event.d/jihad                              (own job; NOT `browserserver`)
# The stock BrowserAdapter.so / browserserver / /tmp/yapserver.browser are left untouched.
# Reversed by prerm.
APP=/media/cryptofs/apps/usr/palm/applications/net.riverstonerelay.jihad-browser
DR=$APP/deviceroot
log() { echo "jihad-postinst: $*"; }

# 1. Goanna daemon + its bundled libs -> /media/internal/jihad/hl
log "installing Goanna daemon..."
mkdir -p /media/internal/jihad/hl
cp -a "$DR/hl/." /media/internal/jihad/hl/
chmod 755 /media/internal/jihad/hl/jihad-browserserver /media/internal/jihad/hl/ld-2.23.so 2>/dev/null

# 2. adapter plugin + upstart job live on the read-only rootfs -- one rw window.
log "installing adapter + upstart (rootfs rw)..."
mount -o remount,rw / 2>/dev/null
mkdir -p /usr/lib/BrowserPlugins
cp -a "$DR/BrowserPlugins/BrowserAdapterJihad.so" /usr/lib/BrowserPlugins/BrowserAdapterJihad.so
chmod 755 /usr/lib/BrowserPlugins/BrowserAdapterJihad.so
cp -a "$DR/event.d/jihad" /etc/event.d/jihad
chmod 755 /etc/event.d/jihad
sync
mount -o remount,ro / 2>/dev/null

# 3. start the Goanna daemon + reload LunaSysMgr (picks up the new NPAPI plugin
#    for application/x-jihad-browser).
log "starting Jihad daemon + reloading LunaSysMgr..."
start jihad 2>/dev/null
killall LunaSysMgr 2>/dev/null
log "install complete."
exit 0
